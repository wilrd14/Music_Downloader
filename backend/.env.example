# Rutas opcionales si yt-dlp / ffmpeg no están en el PATH
# YT_DLP_PATH=C:\tools\yt-dlp.exe
# FFMPEG_PATH=C:\tools\ffmpeg\bin

API_PORT=8787
# Carpeta de la interfaz compilada (por defecto ../frontend/dist)
# STATIC_DIR=
MAX_TRACKS_PER_JOB=100
JOB_TTL_MINUTES=30
WORKER_CONCURRENCY=2
# Tiempo máximo por pista (descarga + conversión)
TRACK_TIMEOUT_MINUTES=10
# Origen permitido por CORS si el frontend se sirve desde otro dominio
# CORS_ORIGIN=https://tunedrop.wilrd14.dev

# Spotify Web API (solo lectura de metadatos)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
