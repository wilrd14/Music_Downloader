# Modo de funcionamiento: local (por defecto; cada persona en su PC, guarda en su carpeta de música,
# sin límites por IP ni Turnstile) o server (servicio público con límites, Turnstile y ZIP).
# Un despliegue como servicio DEBE poner TUNEDROP_MODE=server.
# TUNEDROP_MODE=local
# Modo local: carpeta de música por defecto (el ajuste elegido en la interfaz tiene prioridad).
# Por defecto <home>/Music/tunedrop
# DOWNLOAD_DIR=
# Carpeta con yt-dlp y ffmpeg empaquetados (se buscan aquí antes que en YT_DLP_PATH / FFMPEG_PATH / PATH).
# Por defecto <app>/bin
# TUNEDROP_BIN_DIR=
# Modo local: actualizar el yt-dlp de TUNEDROP_BIN_DIR al arrancar (máx. cada 24 h). 0 = desactivado.
# YT_DLP_AUTO_UPDATE=1
# Modo local: 1 = no abrir el navegador al arrancar.
# TUNEDROP_NO_BROWSER=1

# Rutas opcionales si yt-dlp / ffmpeg no están en el PATH
# YT_DLP_PATH=C:\tools\yt-dlp.exe
# FFMPEG_PATH=C:\tools\ffmpeg\bin

API_PORT=8787
# Carpeta de la interfaz compilada (por defecto ../frontend/dist)
# STATIC_DIR=
MAX_TRACKS_PER_JOB=100
JOB_TTL_MINUTES=30
WORKER_CONCURRENCY=2
# Canciones de un mismo trabajo que se descargan a la vez (1 = en serie)
TRACK_CONCURRENCY=3
# Tope global de descargas simultáneas (yt-dlp + ffmpeg) entre todos los trabajos
MAX_PARALLEL_DOWNLOADS=4
# Tiempo máximo por pista (descarga + conversión)
TRACK_TIMEOUT_MINUTES=10
# Origen permitido por CORS si el frontend se sirve desde otro dominio
# CORS_ORIGIN=https://tunedrop.wilrd14.dev

# Límites por IP (peticiones por minuto) y topes. Valores por defecto:
# RATE_LIMIT_GENERAL_PER_MIN=120
# RATE_LIMIT_RESOLVE_PER_MIN=20
# RATE_LIMIT_JOBS_PER_MIN=6
# RATE_LIMIT_DOWNLOAD_PER_MIN=30
# MAX_QUEUED_JOBS=30
# MAX_ACTIVE_JOBS_PER_IP=2
# MAX_DISK_MB=4096

# Cloudflare Turnstile (anti-bots). Claves reales: panel de Cloudflare > Turnstile.
# Sin TURNSTILE_SECRET_KEY no se verifica nada (solo desarrollo).
# Para pruebas Cloudflare publica claves ficticias (ver developers.cloudflare.com/turnstile/troubleshooting/testing/).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
